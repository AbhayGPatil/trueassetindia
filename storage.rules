rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow public read access
      allow read: if true;
      // Allow authenticated write and delete
      allow write, delete: if request.auth != null;
    }

    // Dedicated path for notary profile pictures
    match /notary-profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write, delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
